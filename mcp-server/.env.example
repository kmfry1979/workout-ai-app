# Same Supabase project the main app and garmin-sync use.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_USER_ID=uuid-of-the-app-user

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI must be: <MCP_BASE_URL>/auth/callback
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Public URL this server is reachable at (no trailing slash).
MCP_BASE_URL=https://athleteiq-mcp.fryski.duckdns.org

# Signs FastMCP's own session JWTs. Must stay constant across restarts/
# redeploys, or every connected client is forced to re-login.
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_JWT_SIGNING_KEY=replace-with-a-long-random-secret

# Only this Google account is allowed to call any tool.
ALLOWED_EMAIL=kmfry1979@gmail.com

# Port the streamable-http server listens on.
PORT=8000
