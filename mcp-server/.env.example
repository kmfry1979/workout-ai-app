# Same Supabase project the main app and garmin-sync use.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_USER_ID=uuid-of-the-app-user

# Shared secret Claude Desktop must send as a Bearer token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# Port the streamable-http server listens on.
PORT=8000
